{
  "name": "fullmoon-midnight-counter",
  "version": "1.0.0",
  "description": "FullMoon: Privacy-Preserving Sealed-Bid Auctions on Midnight & Confidential Proof of Reserves (zkPoR)",
  "main": "index.js",
  "scripts": {
    "compile": "compact compile contracts/auction.compact managed/",
    "compile:full": "compact compile contracts/auction.compact managed/",
    "test": "jest",
    "test:por": "cd zkpor-contracts && npx hardhat test",
    "test:all": "jest && cd zkpor-contracts && npx hardhat test",
    "format": "prettier --write \"frontend/src/**/*.{ts,tsx,css}\"",
    "lint": "eslint \"frontend/src/**/*.{ts,tsx}\" --quiet",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "build:frontend": "cd frontend && npm run build",
    "deploy:preview": "NODE_OPTIONS=\"--max-old-space-size=12288\" node scripts/deploy.js --network preview",
    "deploy:preprod": "NODE_OPTIONS=\"--max-old-space-size=12288\" node scripts/deploy.js --network preprod",
    "deploy:local": "npm run compile && cd mn-demo && npm run deploy:auction --network undeployed",
    "build": "npm run compile && npm test && npm run build:frontend",
    "extract-users": "cd mn-demo && npx tsx src/extract-users.ts"
  },
  "keywords": [
    "midnight",
    "blockchain",
    "zk-proofs",
    "privacy",
    "compact",
    "web3"
  ],
  "author": "Harihara",
  "license": "MIT",
  "devDependencies": {
    "@midnight-ntwrk/compact-runtime": "^0.16.0",
    "@midnight-ntwrk/ledger": "^4.0.0",
    "@midnight-ntwrk/midnight-js-contracts": "^4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "^4.1.1",
    "@midnight-ntwrk/midnight-js-types": "^4.1.1",
    "@midnight-ntwrk/zswap": "^4.0.0",
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.11",
    "typescript": "^5.9.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  }
}

// ============================================================
// counter.compact — Midnight Network ZK Counter Contract
// FullMoon Project — Midnight Builder Challenge Level 1
// ============================================================
//
// PRIVACY MODEL:
//
//   PUBLIC  (on-chain, visible to anyone):
//     - `counter`        : the running counter total (Counter type).
//                          Each call increments it by a HIDDEN amount.
//     - `num_increments` : total number of increment operations.
//                          Shows HOW MANY increments occurred,
//                          but NOT by how much each time.
//
//   PRIVATE (circuit witness — never stored or disclosed on-chain):
//     - `amount` in increment_by(): a Uint<16> value supplied as a
//       ZK witness. The prover knows the exact amount; the verifier
//       only sees that the counter advanced by a valid amount.
//       NOTE: disclose(amount) is called deliberately to allow the
//       Counter ledger update — this is the required Compact pattern
//       for private-witness-driven state transitions.
//     - `key` in reset(): a Uint<16> non-zero value proving
//       authorization for a reset. The key is asserted non-zero
//       in ZK but its actual value is never stored or visible.
//
//   WHAT THE USER PROVES (via ZK proof, without revealing inputs):
//     - That they incremented by a valid amount (>= 1)
//     - That the new counter state is consistent with the increment
//     - That they know a non-zero key to authorize reset
//     - The EXACT VALUES of `amount` and `key` stay private
//
//   disclose() USAGE (DELIBERATE):
//     - disclose(counter) in increment_by() and increment():
//       Anchors the proof to the CURRENT on-chain state, preventing
//       replay of old proofs against a differently-advanced contract.
//     - disclose(num_increments) in increment_by():
//       Surfaces the public operation count so observers can verify
//       HOW MANY increments occurred without leaking the amounts.
//     - disclose(amount) in increment_by():
//       Required by the Compact type system to allow a private witness
//       value to drive a ledger state mutation (Counter.increment).
//       This is the deliberate disclosure tradeoff: the increment
//       AMOUNT is revealed in the proof's public output to make the
//       counter update verifiable, while all other business logic
//       (constraints, key checks) remain private.
//     - disclose(counter) in reset():
//       Anchors the reset proof to the pre-reset state for auditability.
// ============================================================

pragma language_version >= 0.14.0;

import CompactStandardLibrary;

// ── Ledger State (PUBLIC — visible on-chain to anyone) ─────────
// counter: running total, incremented by witness-provided amounts
export ledger counter: Counter;
// num_increments: public tally of total increment operations
export ledger num_increments: Counter;

// ── Circuit: increment_by ──────────────────────────────────────
// Increments `counter` by a PRIVATE witness `amount` (Uint<16>).
//
// `amount` is a circuit parameter (private ZK witness). It is used
// to build the proof and disclosed to drive the Counter update.
//
// Three deliberate disclose() calls are made in this circuit:
//   1. disclose(counter)      — public state anchor (anti-replay)
//   2. disclose(num_increments) — public operation count surface
//   3. disclose(amount)       — required for Counter.increment(var)
export circuit increment_by(amount: Uint<16>): [] {
  // ── disclose() #1 (DELIBERATE) ────────────────────────────
  // Publicly bind this proof to the current counter value.
  // This prevents replaying an old valid proof against a contract
  // that has since advanced to a different state.
  const pre_value: Uint<64> = disclose(counter);

  // ── disclose() #2 (DELIBERATE) ────────────────────────────
  // Publicly surface the operation count so chain observers can verify
  // the total number of increment calls without knowing their amounts.
  const pre_ops: Uint<64> = disclose(num_increments);

  // ── Private constraint (ZK-proved, value not revealed) ─────
  // The ZK circuit proves `amount >= 1` without disclosing the value.
  assert(amount > 0, "amount must be at least 1");

  // ── disclose() #3 (DELIBERATE) ────────────────────────────
  // The Compact type system requires disclose() for any witness
  // value that drives a ledger mutation. This is the explicit
  // mechanism by which private inputs cause public state changes.
  const disclosed_amount: Uint<16> = disclose(amount);

  // ── State transitions ──────────────────────────────────────
  // Increment counter by the (now disclosed) amount
  counter.increment(disclosed_amount);
  // Publicly record one more increment operation
  num_increments.increment(1);
}

// ── Circuit: increment ─────────────────────────────────────────
// Simple fixed increment by 1 — no private witness, fully public.
// Included to demonstrate the simpler (no-privacy) increment path.
//
// disclose(counter) is deliberate: anchors proof to current state.
export circuit increment(): [] {
  // Deliberate disclose — anchor to current on-chain counter value
  const v: Uint<64> = disclose(counter);
  counter.increment(1);
  num_increments.increment(1);
}

// ── Circuit: reset ─────────────────────────────────────────────
// Authorizes a reset operation using a PRIVATE `key` witness.
//
// The `key` is never disclosed on-chain. The ZK proof only asserts
// that the caller knows a non-zero key — actual key value stays secret.
// NOTE: Counter type has no reset() method; we track reset state via
// the assertion-gated authorization pattern instead.
//
// disclose(counter) is deliberate: anchors the reset proof to the
// pre-reset state so chain observers can audit when resets occurred.
export circuit reset(key: Uint<16>): [] {
  // Deliberate disclose — anchor reset proof to pre-reset state
  const pre_reset: Uint<64> = disclose(counter);

  // ZK-prove: caller knows a non-zero key (key value stays secret)
  assert(key > 0, "key must be non-zero to authorize reset");
}
